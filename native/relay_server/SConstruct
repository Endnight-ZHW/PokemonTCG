#!/usr/bin/env python

import os
import sys
import json
from SCons.Script import ARGUMENTS, Default, Environment

repo_root = os.path.abspath(os.path.join("..", ".."))
boost_root = os.path.join(repo_root, ".tools", "native", "boost_1_92_0")
json_root = os.path.join(repo_root, ".tools", "native", "nlohmann-json", "include")
configuration = ARGUMENTS.get("configuration", "release")
with open(os.path.join(repo_root, "godot", "data", "release_manifest.json"), encoding="utf-8") as handle:
    relay_version = str(json.load(handle)["version"])
relay_version_parts = [int(part) for part in relay_version.split(".")]
if len(relay_version_parts) != 3:
    raise ValueError("release version must have three numeric components")
if configuration not in ("debug", "release"):
    raise ValueError("configuration must be debug or release")
for required in (
    os.path.join(boost_root, "boost", "beast.hpp"),
    os.path.join(json_root, "nlohmann", "json.hpp"),
):
    if not os.path.isfile(required):
        raise RuntimeError("Missing pinned native dependency: " + required)

env = Environment(ENV=os.environ)
env.Append(CPPPATH=["src", boost_root, json_root])
env.Append(CPPDEFINES=[
    "BOOST_ERROR_CODE_HEADER_ONLY",
    "BOOST_SYSTEM_NO_DEPRECATED",
    "BOOST_SYSTEM_NO_LIB",
    ("PTCG_RELAY_VERSION_MAJOR", relay_version_parts[0]),
    ("PTCG_RELAY_VERSION_MINOR", relay_version_parts[1]),
    ("PTCG_RELAY_VERSION_PATCH", relay_version_parts[2]),
])
if sys.platform == "win32":
    env.Append(CPPDEFINES=["WIN32_LEAN_AND_MEAN", "NOMINMAX", "_WIN32_WINNT=0x0A00"])
    env.Append(CXXFLAGS=["/EHsc", "/std:c++17", "/utf-8", "/W4"])
    env.Append(CXXFLAGS=["/O2", "/DNDEBUG"] if configuration == "release" else ["/Od", "/Z7"])
    env.Append(LIBS=["bcrypt", "ws2_32", "mswsock"])
else:
    env.Append(CXXFLAGS=["-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-pthread"])
    env.Append(CXXFLAGS=["-O2", "-DNDEBUG"] if configuration == "release" else ["-O0", "-g"])
    env.Append(LINKFLAGS=["-pthread"])

protocol_object = env.Object(os.path.join("build", configuration, "relay_protocol"), "src/relay_protocol.cpp")[0]
server_object = env.Object(os.path.join("build", configuration, "relay_server"), "src/relay_server.cpp")[0]
test_object = env.Object(os.path.join("build", configuration, "relay_protocol_test"), "tests/relay_protocol_test.cpp")[0]
integration_object = env.Object(
    os.path.join("build", configuration, "relay_integration_test"),
    "tests/relay_integration_test.cpp",
)[0]
benchmark_object = env.Object(
    os.path.join("build", configuration, "relay_benchmark"),
    "tests/relay_benchmark.cpp",
)[0]

server = env.Program(os.path.join("bin", "ptcg_relay_server"), [server_object, protocol_object])
tests = env.Program(os.path.join("bin", "relay_protocol_tests"), [test_object, protocol_object])
integration_tests = env.Program(
    os.path.join("bin", "relay_integration_tests"),
    [integration_object],
)
benchmark = env.Program(os.path.join("bin", "relay_benchmark"), [benchmark_object])
env.NoCache([server, tests, integration_tests, benchmark])
Default([server, tests, integration_tests, benchmark])
