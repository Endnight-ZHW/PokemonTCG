#!/usr/bin/env python

import sys
import os
import json
from SCons.Script import Default, Environment
rules_source_root = os.path.abspath(os.path.join("..", "ptcg_core", "src"))
common_root = os.path.abspath(os.path.join("..", "common"))
repo_root = os.path.abspath(os.path.join("..", ".."))
json_root = os.path.join(repo_root, ".tools", "native", "nlohmann-json", "include")

env = Environment(ENV=os.environ)
env.Append(CPPPATH=["src", rules_source_root, common_root, json_root])
if sys.platform == "win32":
    env.Append(CXXFLAGS=["/EHsc", "/std:c++17", "/O2", "/utf-8"])
else:
    env.Append(CXXFLAGS=["-std=c++17", "-O2"])

# Compile the production source manifests so tactics tests exercise the same
# policy implementations and rules-derived facts as both native bindings.
test_objects = [env.Object(os.path.join('build', 'challenge_tactics_test'),
                           'tests/challenge_tactics_test.cpp')[0]]
for component, directory in [('ptcg_core', '../ptcg_core'), ('challenge_core', '.')]:
    with open(os.path.join(directory, 'source_manifest.json'), encoding='utf-8') as manifest_file:
        sources = json.load(manifest_file)['runtime']
    for name in sources:
        test_objects.append(env.Object(os.path.join('build', component, name[:-4]),
                                       os.path.join(directory, 'src', name))[0])
program = env.Program(
    os.path.join("bin", "challenge_core_tests"),
    source=test_objects,
)
env.NoCache(program)
context_tests = env.Program(
    os.path.join("bin", "search_context_tests"),
    source=env.Object(os.path.join("build", "search_context_test"),
                      "tests/search_context_test.cpp"),
)
budget_tests = env.Program(
    os.path.join("bin", "decision_budget_tests"),
    source=env.Object(os.path.join("build", "decision_budget_test"),
                      "tests/decision_budget_test.cpp"),
)
Default(program, context_tests, budget_tests)
