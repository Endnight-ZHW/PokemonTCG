[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/dialogs/settings_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://ui/frontend/front_end_theme.tres" id="2_theme"]

[node name="SettingsPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(0, 0)
theme = ExtResource("2_theme")
theme_override_constants/separation = 14
editor_description = "分区设置内容。恢复默认只修改表单，保存后才写入 AppSettings。"
script = ExtResource("1_panel")

[node name="IntroRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Intro" type="Label" parent="IntroRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"FrontMutedLabel"
text = "所有设置保存在应用私有目录，可随时恢复默认值。"
vertical_alignment = 1
autowrap_mode = 2

[node name="ResetDefaultsButton" type="Button" parent="IntroRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 48)
layout_mode = 2
theme_type_variation = &"FrontGhostButton"
text = "恢复默认值"

[node name="AudioSection" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"FrontSectionPanel"

[node name="Margin" type="MarginContainer" parent="AudioSection"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18

[node name="Content" type="VBoxContainer" parent="AudioSection/Margin"]
