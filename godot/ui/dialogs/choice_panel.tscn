[ext_resource type="Script" path="res://ui/dialogs/choice_panel.gd" id="1_panel"]

[node name="ChoicePanel" type="VBoxContainer"]
theme_override_constants/separation = 10
editor_description = "复杂规则选择的可视化容器。卡牌选项渲染为单一卡牌网格，非卡牌选项渲染为紧凑按钮。"
script = ExtResource("1_panel")

