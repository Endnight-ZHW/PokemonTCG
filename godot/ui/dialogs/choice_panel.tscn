[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/dialogs/choice_panel.gd" id="1_panel"]

[node name="ChoicePanel" type="VBoxContainer"]
theme_override_constants/separation = 10
editor_description = "复杂规则选择的可视化容器。卡牌选项渲染为单一卡牌网格，非卡牌选项渲染为紧凑按钮。"
script = ExtResource("1_panel")

[node name="MetadataLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.784, 0.29, 1)
theme_override_font_sizes/font_size = 17
text = "请选择 1 项"
autowrap_mode = 2

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.612, 0.675, 0.773, 1)
text = "点击确认继续结算。"

[node name="EnergyPreview" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="EnergyPreviewLabel" type="Label" parent="EnergyPreview"]
layout_mode = 2
theme_override_colors/font_color = Color(0.612, 0.675, 0.773, 1)
theme_override_font_sizes/font_size = 13
text = "待分配能量"

[node name="EnergyGrid" type="HFlowContainer" parent="EnergyPreview"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="CardGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
columns = 5

[node name="OptionList" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
