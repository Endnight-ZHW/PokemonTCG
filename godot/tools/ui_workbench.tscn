[node name="PreviewColumn" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PreviewCaption" type="Label" parent="Layout/PreviewColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.784, 0.29, 1)
theme_override_font_sizes/font_size = 18
text = "预览"
vertical_alignment = 1

[node name="PreviewHost" type="Control" parent="Layout/PreviewColumn"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_vertical = 3
editor_description = "预览页面挂载点。运行时只存在一个预览页面。"
