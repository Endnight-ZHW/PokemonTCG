[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/battle/components/battle_log_panel.gd" id="1_log"]

[sub_resource type="StyleBoxFlat" id="Style_hud"]
bg_color = Color(0.02, 0.041, 0.076, 0.975)
border_width_left = 2
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.278, 0.627, 0.843, 0.88)
corner_radius_top_left = 16
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 16
content_margin_left = 16.0
content_margin_top = 14.0
content_margin_right = 14.0
content_margin_bottom = 14.0
shadow_color = Color(0, 0, 0, 0.58)
shadow_size = 12
shadow_offset = Vector2(-6, 3)

[node name="LogPanel" type="PanelContainer"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(360, 260)
layout_mode = 2
mouse_filter = 0
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/panel = SubResource("Style_hud")
editor_description = "战斗行动日志抽屉。默认收起，由 BattlePhaseHud 的日志按钮控制显示。"
script = ExtResource("1_log")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Content/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.98, 0.733, 0.224, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.72)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 16
text = "行动日志"
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="Content/HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
focus_mode = 0
flat = true
theme_override_colors/font_color = Color(0.607, 0.749, 0.851, 1)
theme_override_colors/font_hover_color = Color(1, 0.86, 0.49, 1)
theme_override_colors/font_pressed_color = Color(0.98, 0.733, 0.224, 1)
theme_override_font_sizes/font_size = 18
text = "×"
tooltip_text = "收起行动日志"

[node name="LogLabel" type="RichTextLabel" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.816, 0.878, 0.933, 1)
theme_override_constants/line_separation = 2
theme_override_font_sizes/normal_font_size = 13
scroll_following = true
autowrap_mode = 1
text = "尚无行动记录"

[connection signal="pressed" from="Content/HeaderRow/CloseButton" to="." method="_on_close_pressed"]
